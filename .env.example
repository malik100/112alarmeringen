# Kopieer naar .env en vul in. Dit bestand bevat geheimen: niet committen.

# Home Assistant (alleen nodig als location.homeassistant.enabled of meldingen via HA aan staan).
# Maak een token aan in HA: Profiel -> Beveiliging -> Langdurige toegangstokens.
HA_URL=http://homeassistant:8123
HA_TOKEN=
# De device_tracker van je telefoon (Companion app), bijv. device_tracker.pixel_8
HA_ENTITY_ID=device_tracker.telefoon

# Alleen nodig als je ntfy met toegangsbeheer gebruikt.
NTFY_TOKEN=

LOG_LEVEL=INFO
